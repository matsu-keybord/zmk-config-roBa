// #include <input/processors.dtsi>

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 3
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define JP_YEN 0x89
#define JP_PIPE LS(0x89)
#define JP_UNDERSCORE LS(0x87)

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball { scroll-layers = <4>; };

/ {
    // combos { compatible = "zmk,combos"; };

    macros {
        exit_AML: exit_AML {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings = <&tog_off 0>;
            label = "exit_AML";
        };

        kp_exit_AML: kp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &to MACRO_PLACEHOLDER &exit_AML>;
            label = "KP_exit_AML";
        };
    };

    behaviors {
        tog_off: toggle_layer_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };

        mt_exit_AML_on_tap: mt_exit_AML_on_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_exit_AML_ON_TAP";
            bindings = <&kp>, <&kp_exit_AML>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <200>;
        };

        msc_up_down: msc_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MSC_UP_DOWN";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        };

        lang: lang {
            compatible = "zmk,behavior-tap-dance";
            label = "LANG";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_1>, <&kp LANGUAGE_2>;
        };

        msc_right_left: msc_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MSC_RIGHT_LEFT";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
        };
    };

    combos {
        compatible = "zmk,combos";

        FONT_SMALL {
            bindings = <&kp LC(LS(LESS_THAN))>;
            key-positions = <23 24>;
        };

        FONT_LARGE {
            bindings = <&kp LS(LC(GREATER_THAN))>;
            key-positions = <24 25>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT {
            bindings = <
&kp Q             &kp W         &kp E         &kp R        &kp T                                         &kp Y        &kp U  &kp I      &kp O    &kp P
&mt LEFT_SHIFT A  &kp S         &kp D         &kp F        &kp G  &mkp RCLK          &kp SEMICOLON       &kp H        &kp J  &kp K      &kp L    &mt LCTRL MINUS
&kp Z             &kp X         &kp C         &kp V        &kp B  &to 1              &to 3               &kp N        &kp M  &kp COMMA  &kp DOT  &kp QUESTION
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt 2 SPACE  &lang  &kp BACKSPACE      &mt LEFT_SHIFT TAB  &lt 4 ENTER                             &lt 5 DELETE
            >;

            sensor-bindings = <&msc_up_down>;
        };

        FUNC-NUM {
            bindings = <
&kp F9  &kp F10  &kp F11  &kp F12  &kp NON_US_BACKSLASH                          &kp DOUBLE_QUOTES  &kp N7  &kp N8  &kp N9  &kp SLASH
&kp F5  &kp F6   &kp F7   &kp F8   &kp UNDERSCORE        &trans          &trans  &kp COLON          &kp N4  &kp N5  &kp N6  &kp MINUS
&kp F1  &kp F2   &kp F3   &kp F4   &trans                &kp DELETE      &trans  &kp N0             &kp N1  &kp N2  &kp N3  &kp PERIOD
&trans  &trans   &trans   &trans   &to 0                 &trans          &trans  &trans                                     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        SYMBOLS {
            bindings = <
&kp ESCAPE       &kp EQUAL      &kp LEFT_BRACE  &trans            &trans                           &trans           &kp UNDERSCORE        &kp JP_UNDERSCORE  &kp PLUS          &kp LS(NON_US_BACKSLASH)
&kp EXCLAMATION  &kp HASH       &kp DOLLAR      &kp CARET         &kp PERCENT  &trans      &trans  &kp ASTERISK     &kp LEFT_PARENTHESIS  &kp LEFT_BRACKET   &kp SINGLE_QUOTE  &kp RIGHT_BRACKET
&trans           &kp LESS_THAN  &kp SLASH       &kp GREATER_THAN  &trans       &trans      &trans  &kp RIGHT_BRACE  &kp PIPE              &kp AT_SIGN        &kp AMPERSAND     &kp BACKSLASH
&trans           &trans         &trans          &trans            &trans       &trans      &trans  &trans                                                                      &trans
            >;

            sensor-bindings = <&msc_up_down>;
        };

        MOUSE {
            bindings = <
&kp LEFT_ALT  &kp LC(HOME)        &trans              &kp LC(END)          &trans                      &trans  &mkp MB4        &sk LEFT_SHIFT  &mkp MB5         &kp LEFT_ALT
&kp LCTRL     &trans              &kp LS(UP_ARROW)    &trans               &trans  &trans      &trans  &trans  &mkp MB1        &kp UP_ARROW    &mkp MB2         &kp LCTRL
&kp LEFT_WIN  &kp LS(LEFT_ARROW)  &kp LS(DOWN_ARROW)  &kp LS(RIGHT_ARROW)  &trans  &trans      &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LEFT_WIN
&trans        &trans              &trans              &trans               &to 0   &trans      &to 0   &trans                                                   &trans
            >;

            sensor-bindings = <&msc_up_down>;
        };

        SHORTCUT {
            bindings = <
&trans         &trans  &trans         &kp LG(R)      &kp LC(LS(T))                                     &trans  &trans  &trans  &trans         &kp PRINTSCREEN
&kp LG(LS(S))  &trans  &trans         &kp LC(LS(F))  &trans         &trans      &kp LC(LS(SEMICOLON))  &trans  &trans  &trans  &kp LC(LS(L))  &kp LA(LS(RIGHT_ARROW))
&trans         &trans  &kp LC(LS(C))  &kp LC(LS(V))  &trans         &trans      &trans                 &trans  &trans  &trans  &trans         &trans
&trans         &trans  &trans         &trans         &kp GRAVE      &trans      &trans                 &trans                                 &trans
            >;

            sensor-bindings = <&msc_right_left>;
        };

        BLUETOOTH {
            bindings = <
&bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4                                   &trans  &trans  &trans  &trans  &trans
&bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4  &trans              &trans      &trans  &trans  &trans  &trans  &trans
&trans         &trans         &trans         &trans         &trans         &bt BT_CLR          &trans      &trans  &trans  &trans  &trans  &trans
&trans         &trans         &trans         &trans         &trans         &bt BT_CLR_ALL      &sys_reset  &trans                          &trans
            >;

            sensor-bindings = <&msc_up_down>;
        };
    };
};
